# Transport Assistant — przykład konfiguracji
# Skopiuj do .env i uzupełnij prawdziwymi danymi.

# ── LLM ──────────────────────────────────────────────────────────────────────
# Tryb: remote (Anthropic API) | stub (szablony, bez klucza) | local (przyszłość)
LLM_MODE=remote
ANTHROPIC_API_KEY=your_anthropic_api_key_here
# Opcjonalnie — domyślnie claude-sonnet-4-6
# CLAUDE_MODEL=claude-sonnet-4-6

# ── Trans.eu API ──────────────────────────────────────────────────────────────
TRANS_CLIENT_ID=
TRANS_CLIENT_SECRET=
TRANS_API_KEY=
TRANS_USERNAME=jan.kowalski@trans.eu
TRANS_PASSWORD=

# ── E-mail / Thunderbird (IMAP) ───────────────────────────────────────────────
EMAIL_HOST=imap.example.com
EMAIL_USER=firma@example.com
EMAIL_PASSWORD=
EMAIL_FOLDER=INBOX

# ── Poller ───────────────────────────────────────────────────────────────────
# Jak często (w sekundach) sprawdzać nowe maile i zdarzenia Trans.eu
POLL_INTERVAL_SECONDS=60
